generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

model Role {
  id String @id @default(uuid())

  name String @unique

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(uuid())

  username String @unique
  email String @unique
  password String

  avatar String?
  rating Int @default(0)

  status UserStatus @default(ACTIVE)

  roleId String
  role Role @relation(fields: [roleId],references: [id])

  refreshTokens RefreshToken[]

  createdProblems Problem[] @relation("ProblemCreatedBy")

  submissions Submission[]

  contests UserContest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
}

model RefreshToken {
  id String @id @default(uuid())

  token String @unique
  expiresAt DateTime

  userId String

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Problem {
  id String @id @default(uuid())

  title String
  slug String @unique

  description String @db.LongText
  constraints String? @db.LongText
  hints String? @db.LongText

  difficulty Difficulty

  createdById String

  createdBy User @relation("ProblemCreatedBy",fields: [createdById], references: [id])

  tags ProblemTag[]
  testCases TestCase[]
  submissions Submission[]
  contestProblems ContestProblem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([difficulty])
  @@index([createdById])
}

model Tag {
  id String @id @default(uuid())

  name String @unique

  problems ProblemTag[]

  createdAt DateTime @default(now())
}

model ProblemTag {
  problemId String
  tagId String

  problem Problem @relation(fields: [problemId],references: [id],onDelete: Cascade)

  tag Tag @relation(fields: [tagId],references: [id],onDelete: Cascade)

  @@id([problemId, tagId])
  @@index([tagId])
}

model TestCase {
  id String @id @default(uuid())

  problemId String

  input String @db.LongText
  expectedOutput String @db.LongText

  isSample Boolean @default(false)

  explanation String? @db.LongText

  problem Problem @relation(fields: [problemId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([problemId])
}

model Language {
  id String @id @default(uuid())

  name String @unique
  version String?

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id String @id @default(uuid())

  code String @db.LongText

  status SubmissionStatus @default(PENDING)

  runtime Int?
  memory Int?

  problemId String
  userId String
  languageId String

  problem Problem @relation(fields: [problemId],references: [id],onDelete: Cascade)

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  language Language @relation(fields: [languageId],references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([problemId, createdAt])
  @@index([userId, problemId])
  @@index([status])
}

model Contest {
  id String @id @default(uuid())

  title String
  slug String @unique

  description String? @db.LongText

  startTime DateTime
  endTime DateTime

  participants UserContest[]

  contestProblems ContestProblem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime, endTime])
}

model ContestProblem {
  id String @id @default(uuid())

  contestId String
  problemId String

  orderNo Int

  contest Contest @relation(fields: [contestId],references: [id],onDelete: Cascade)

  problem Problem @relation(fields: [problemId],references: [id],onDelete: Cascade)

  @@unique([contestId, problemId])
  @@index([contestId, orderNo])
}

model UserContest {
  id String @id @default(uuid())

  userId String
  contestId String

  score Int @default(0)
  rank Int?

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  contest Contest @relation(fields: [contestId],references: [id],onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([contestId, rank])
}